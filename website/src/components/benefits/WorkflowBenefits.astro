---
const base = import.meta.env.BASE_URL;
---

<section
  class="workflow-benefits"
  aria-label="Une image sans distraction, reliée à vos outils"
>
  <div class="workflow-photo" aria-hidden="true">
    <img
      src={`${base}images/coast-960.webp`}
      alt=""
      width="960"
      height="640"
      loading="lazy"
    />
    <span class="photo-corner corner-a"></span>
    <span class="photo-corner corner-b"></span>
    <span class="exif-preview">
      <b>IMG_2041.ARW</b>
      <span>ISO 800&nbsp;&nbsp; 1/250 s&nbsp;&nbsp; f/2.8</span>
    </span>
    <span class="app-preview">Lightroom</span>
  </div>

  <article class="window-benefit">
    <h3>Toute la place à l’image</h3>
    <p>La fenêtre épouse la photo, sans bordure ni barre de titre.</p>
  </article>

  <article class="info-benefit">
    <h3>Les infos, au bon moment</h3>
    <p>Nom, date et EXIF apparaissent au survol.</p>
  </article>

  <article class="lightroom-benefit">
    <h3>Continuez dans Lightroom</h3>
    <p>Par clic droit, envoyez la photo vers Lightroom ou l’app choisie.</p>
  </article>
</section>

<style>
  .workflow-benefits {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: repeat(3, minmax(112px, auto));
    align-items: center;
    min-height: 390px;
    padding: 16px 0 10px;
  }

  .workflow-photo {
    position: relative;
    grid-column: 4 / 10;
    grid-row: 1 / 4;
    width: 100%;
    aspect-ratio: 3 / 2;
    align-self: center;
    background: #172b46;
  }

  .workflow-photo > img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo-corner {
    position: absolute;
    width: 28px;
    height: 28px;
    border-color: #2057d4;
    border-style: solid;
  }

  .corner-a {
    top: -7px;
    left: -7px;
    border-width: 2px 0 0 2px;
  }

  .corner-b {
    right: -7px;
    bottom: -7px;
    border-width: 0 2px 2px 0;
  }

  .exif-preview {
    position: absolute;
    bottom: 14px;
    left: 14px;
    display: grid;
    gap: 3px;
    max-width: calc(100% - 28px);
    padding: 9px 11px;
    color: #fff;
    background: #172b46eb;
    border-radius: 5px;
    font-size: 10px;
    line-height: 1.35;
  }

  .exif-preview b {
    font-size: 11px;
    font-weight: 600;
  }

  .app-preview {
    position: absolute;
    top: 18px;
    right: -18px;
    padding: 10px 13px;
    color: #172b46;
    background: #fff;
    border: 1px solid #bdccdd;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
  }

  .workflow-benefits article {
    position: relative;
    z-index: 1;
  }

  .workflow-benefits article p {
    margin-top: 8px !important;
  }

  .window-benefit {
    grid-column: 1 / 4;
    grid-row: 1;
    padding-right: 25px;
  }

  .info-benefit {
    grid-column: 10 / 13;
    grid-row: 2;
    padding-left: 28px;
  }

  .lightroom-benefit {
    grid-column: 1 / 4;
    grid-row: 3;
    padding-right: 25px;
  }

  .window-benefit::after,
  .lightroom-benefit::after,
  .info-benefit::after {
    position: absolute;
    top: 18px;
    width: 22px;
    height: 1px;
    content: "";
    background: #91a8c2;
  }

  .window-benefit::after,
  .lightroom-benefit::after {
    right: 0;
  }

  .info-benefit::after {
    left: 0;
  }

  @media (max-width: 900px) {
    .workflow-benefits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto;
      gap: 26px 30px;
      min-height: 0;
      padding: 20px 0;
    }

    .workflow-photo {
      grid-column: 1 / -1;
      grid-row: auto;
      width: min(100%, 570px);
      justify-self: center;
      margin-bottom: 8px;
    }

    .window-benefit,
    .info-benefit,
    .lightroom-benefit {
      grid-column: auto;
      grid-row: auto;
      padding: 0;
    }

    .lightroom-benefit {
      grid-column: 1 / -1;
      max-width: 460px;
      justify-self: center;
      text-align: center;
    }

    .window-benefit::after,
    .lightroom-benefit::after,
    .info-benefit::after {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .workflow-benefits {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .window-benefit,
    .info-benefit,
    .lightroom-benefit {
      grid-column: auto;
      max-width: none;
      text-align: left;
    }

    .app-preview {
      right: -5px;
    }

    .exif-preview {
      right: 10px;
      bottom: 10px;
      left: 10px;
      max-width: none;
      font-size: 9px;
    }
  }
</style>
