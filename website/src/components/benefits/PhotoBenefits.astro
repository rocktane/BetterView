---
import Keycap from "../Keycap.astro";

const base = import.meta.env.BASE_URL;
const compareSizes = "(max-width: 720px) 48vw, (max-width: 1080px) 30vw, 320px";
const wideSizes =
  "(max-width: 720px) calc(100vw - 32px), (max-width: 1080px) 55vw, 600px";

const shortcuts = [
  {
    id: "flow",
    name: "Ouvrez. C’est prêt.",
    description:
      "Sans catalogue. La fenêtre épouse chaque photo ; la suivante préparée s’affiche en moins de 1 ms.",
    keys: ["←", "→"],
    keyLabel: "Flèches gauche et droite",
  },
  {
    id: "batch",
    name: "Triez par lots, sans risque",
    description:
      "Sélectionnez une photo ou une plage. ⌘Z et l’historique corrigent les erreurs ; les photos protégées le restent.",
    keys: ["S", "⇧", "⌘", "Z"],
    keyLabel: "S, Maj, Command et Z",
  },
  {
    id: "tools",
    name: "Passez à la retouche",
    description: "EXIF au survol, puis Lightroom par clic droit.",
    keys: ["I"],
    keyLabel: "I pour les informations",
  },
];
---

<section
  class="photo-benefits"
  aria-label="Comparer, zoomer et vérifier la netteté"
>
  <article class="photo-benefit comparison-benefit">
    <div class="benefit-copy">
      <div class="benefit-heading">
        <span aria-hidden="true">
          <Keycap label="C" />
        </span>
        <h3>Gardez la meilleure</h3>
      </div>
      <p>
        Comparez les photos d’une rafale côte à côte dans l’app. Ici, deux
        cadrages de la même photo.
      </p>
    </div>
    <div class="benefit-visual comparison-visual" aria-hidden="true">
      <div class="portrait-frame">
        <img
          src={`${base}images/benefits/compare-wide-800.webp`}
          srcset={`${base}images/benefits/compare-wide-400.webp 400w, ${base}images/benefits/compare-wide-800.webp 800w`}
          sizes={compareSizes}
          alt=""
          width="800"
          height="1000"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="portrait-frame">
        <img
          src={`${base}images/benefits/compare-close-800.webp`}
          srcset={`${base}images/benefits/compare-close-400.webp 400w, ${base}images/benefits/compare-close-800.webp 800w`}
          sizes={compareSizes}
          alt=""
          width="800"
          height="1000"
          loading="lazy"
          decoding="async"
        />
        <span class="selection-mark">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="m6 12 4 4 8-9"></path>
          </svg>
        </span>
      </div>
    </div>
  </article>

  <article class="photo-benefit detail-benefit">
    <div class="benefit-visual wide-frame detail-visual" aria-hidden="true">
      <img
        src={`${base}images/benefit-detail-mountain-1200.webp`}
        srcset={`${base}images/benefit-detail-mountain-600.webp 600w, ${base}images/benefit-detail-mountain-1200.webp 1200w`}
        sizes={wideSizes}
        alt=""
        width="1200"
        height="800"
        loading="lazy"
        decoding="async"
      />
      <span class="detail-scale">100 %</span>
    </div>
    <div class="benefit-copy">
      <div class="benefit-heading">
        <span aria-hidden="true">
          <Keycap label="Z" />
        </span>
        <h3>Le détail qui tranche</h3>
      </div>
      <p>Zoomez au même endroit sur toutes les photos.</p>
    </div>
  </article>

  <article class="photo-benefit focus-benefit">
    <div class="benefit-visual wide-frame focus-visual" aria-hidden="true">
      <img
        src={`${base}images/benefits/focus-1200.webp`}
        srcset={`${base}images/benefits/focus-600.webp 600w, ${base}images/benefits/focus-1200.webp 1200w`}
        sizes={wideSizes}
        alt=""
        width="1200"
        height="800"
        loading="lazy"
        decoding="async"
      />
      <span class="focus-mark"></span>
    </div>
    <div class="benefit-copy">
      <div class="benefit-heading">
        <span aria-hidden="true">
          <Keycap label="A" />
        </span>
        <h3>Visez la netteté</h3>
      </div>
      <p>Zoomez à 100 % sur le point AF enregistré, si disponible.</p>
    </div>
  </article>

  <section class="shortcut-directions" aria-labelledby="more-benefits-title">
    <h3 id="more-benefits-title">
      Et tout ce qui
      <br />
      facilite le tri.
    </h3>
    <ul class="shortcut-list">
      {shortcuts.map((shortcut) => (
        <li class={`shortcut-item shortcut-item--${shortcut.id}`}>
          <span class="shortcut-keys" aria-label={shortcut.keyLabel}>
            {shortcut.keys.map((key) => (
              <Keycap label={key} variant={7} />
            ))}
          </span>
          <div class="shortcut-copy">
            <h4>{shortcut.name}</h4>
            <p class="shortcut-description">{shortcut.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>
</section>

<style>
  .photo-benefits {
    display: grid;
    gap: clamp(62px, 8vw, 100px);
    padding: clamp(42px, 6vw, 72px) 0 clamp(28px, 4vw, 46px);
  }

  .photo-benefit {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(240px, 0.75fr);
    grid-template-areas: "visual copy";
    align-items: center;
    gap: clamp(30px, 5vw, 64px);
  }

  .comparison-benefit,
  .focus-benefit {
    grid-template-columns: minmax(240px, 0.75fr) minmax(0, 1.1fr);
    grid-template-areas: "copy visual";
  }

  .benefit-visual {
    grid-area: visual;
    min-width: 0;
  }

  .benefit-copy {
    grid-area: copy;
    max-width: 390px;
  }

  .comparison-benefit .benefit-copy,
  .focus-benefit .benefit-copy {
    justify-self: end;
  }

  .benefit-heading {
    display: flex;
    align-items: flex-start;
    gap: 13px;
  }

  .benefit-heading > span {
    padding-top: 3px;
  }

  .benefit-copy h3 {
    font-size: clamp(26px, 2.8vw, 34px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .benefit-copy p {
    max-width: 38ch;
    margin-top: 13px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
    letter-spacing: -0.01em;
  }

  .comparison-visual {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }

  .portrait-frame,
  .wide-frame {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background: #dce6f0;
    border-radius: 4px;
  }

  .portrait-frame {
    aspect-ratio: 4 / 5;
  }

  .wide-frame {
    aspect-ratio: 3 / 2;
  }

  .portrait-frame img,
  .wide-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .selection-mark {
    position: absolute;
    right: 18px;
    bottom: 18px;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    color: #fff;
    background: var(--blue);
    border-radius: 50%;
  }

  .selection-mark svg {
    width: 21px;
    height: 21px;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .detail-scale {
    position: absolute;
    top: 16px;
    right: 16px;
    padding: 8px 11px;
    color: #fff;
    background: #000b;
    border-radius: 8px;
    font-family: -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.25;
  }

  .focus-mark {
    position: absolute;
    top: 30%;
    left: 38.4%;
    width: 3%;
    aspect-ratio: 1;
    border: 1.5px solid #fff;
    border-radius: 50%;
    box-shadow: 0 0 0 1px #172b4633;
    transform: translate(-50%, -50%);
  }

  .shortcut-directions {
    display: grid;
    grid-template-columns: minmax(220px, 0.72fr) minmax(0, 1.4fr);
    align-items: start;
    gap: clamp(38px, 6vw, 74px);
    margin-top: clamp(4px, 2vw, 20px);
  }

  #more-benefits-title {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(30px, 3.6vw, 42px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  .shortcut-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid #cfdae7;
    list-style: none;
  }

  .shortcut-item {
    display: grid;
    grid-template-columns: 144px minmax(0, 1fr);
    align-items: center;
    gap: 22px;
    min-width: 0;
    padding: 24px 0 26px;
    border-bottom: 1px solid #cfdae7;
  }

  .shortcut-keys {
    display: flex;
    align-items: center;
    gap: 5px;
    color: var(--blue);
    white-space: nowrap;
  }

  .shortcut-copy h4 {
    margin: 0;
    font-size: 18px;
    font-weight: 650;
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .shortcut-copy .shortcut-description {
    max-width: 47ch;
    margin: 7px 0 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.55;
    letter-spacing: -0.01em;
  }

  @media (max-width: 720px) {
    .photo-benefits {
      gap: 54px;
      padding: 36px 0 26px;
    }

    .photo-benefit,
    .comparison-benefit,
    .focus-benefit {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "visual" "copy";
      gap: 22px;
    }

    .comparison-benefit .benefit-copy,
    .focus-benefit .benefit-copy {
      justify-self: start;
    }

    .benefit-copy {
      max-width: 520px;
    }

    .benefit-copy h3 {
      font-size: 28px;
    }

    .benefit-copy p {
      font-size: 14px;
    }

    .shortcut-directions {
      grid-template-columns: minmax(0, 1fr);
      gap: 26px;
      margin-top: 0;
    }

    #more-benefits-title {
      max-width: none;
      font-size: 32px;
    }
  }

  @media (max-width: 480px) {
    .photo-benefits {
      gap: 48px;
    }

    .photo-benefit,
    .comparison-benefit,
    .focus-benefit {
      gap: 18px;
    }

    .comparison-visual {
      gap: 4px;
    }

    .selection-mark {
      right: 12px;
      bottom: 12px;
      width: 34px;
      height: 34px;
    }

    .selection-mark svg {
      width: 19px;
      height: 19px;
    }

    .detail-scale {
      top: 12px;
      right: 12px;
      padding: 7px 9px;
      font-size: 13px;
    }

    .shortcut-directions {
      gap: 22px;
    }

    #more-benefits-title {
      font-size: 30px;
    }

    .shortcut-item {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
      padding: 20px 0 22px;
    }
  }
</style>
