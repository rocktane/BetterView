---
import PhotoBenefits from "./PhotoBenefits.astro";
---

<section class="benefits-showcase" aria-labelledby="benefits-title">
  <h2 id="benefits-title" class="visually-hidden">
    Comparer, vérifier et trier ses photos avec BetterView
  </h2>
  <PhotoBenefits />
</section>

<style>
  .benefits-showcase {
    display: grid;
    gap: clamp(18px, 2.4vw, 28px);
    margin: 28px 0 48px;
  }

  .benefits-showcase :global(h3),
  .benefits-showcase :global(p) {
    margin: 0;
  }

  .benefits-showcase :global(h3) {
    font-size: 20px;
    line-height: 1.15;
    letter-spacing: -0.035em;
    font-weight: 650;
  }

  .benefits-showcase :global(p) {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.55;
  }

  @media (max-width: 650px) {
    .benefits-showcase {
      margin-bottom: 36px;
    }

    .benefits-showcase :global(h3) {
      font-size: 18px;
    }
  }
</style>
