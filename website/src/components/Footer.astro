---
import { legal } from "../config/legal";
const base = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div class="footer-about">
    <a class="brand" href={base}>
      BetterView
    </a>
    <p>Une visionneuse RAW pour Mac.</p>
  </div>
  <nav aria-label="Liens de pied de page">
    <a href={legal.repository} target="_blank" rel="noopener noreferrer">
      Code source
    </a>
    <a
      href={`${legal.repository}/issues`}
      target="_blank"
      rel="noopener noreferrer"
    >
      Signaler un problème
    </a>
    <a href={`${base}mentions-legales/`}>Mentions légales</a>
    <a href={`${base}confidentialite/`}>Confidentialité</a>
  </nav>
</footer>
