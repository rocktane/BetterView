---
import Layout from "../layouts/Layout.astro";
import Viewer from "../components/Viewer.astro";
import Benefits from "../components/benefits/Benefits.astro";
import HandwrittenTrials from "../components/HandwrittenTrials.astro";
const base = import.meta.env.BASE_URL;
---

<Layout>
  <main class="landing">
    <header class="hero">
      <h1>
        Place aux photos.
        <img
          class="hero-icon"
          src={`${base}images/icon.svg`}
          alt="BetterView"
          width="88"
          height="88"
        />
      </h1>
      <p>Triez à votre vitesse</p>
      <div class="actions home-actions">
        <a
          class="download-button"
          href="https://github.com/rocktane/BetterView#installation"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.05 12.54c.03 3.07 2.69 4.09 2.72 4.11-.02.07-.42 1.45-1.4 2.87-.84 1.23-1.72 2.45-3.1 2.48-1.36.02-1.8-.81-3.35-.81-1.56 0-2.04.79-3.33.83-1.34.05-2.35-1.33-3.2-2.55-1.74-2.51-3.07-7.1-1.28-10.2a4.96 4.96 0 0 1 4.2-2.55c1.31-.02 2.55.88 3.35.88.8 0 2.31-1.09 3.9-.93.67.03 2.55.27 3.76 2.04-.1.06-2.24 1.3-2.22 3.83ZM14.47 5.2c.7-.85 1.18-2.03 1.05-3.2-1.01.04-2.23.67-2.96 1.52-.65.75-1.22 1.95-1.07 3.1 1.13.09 2.28-.57 2.98-1.42Z" />
          </svg>
          Télécharger pour macOS
        </a>
        <small>macOS 14 et plus</small>
        <HandwrittenTrials />
      </div>
    </header>
    <div id="essayer">
      <Viewer interactive controls={false} />
    </div>
    <Benefits />
  </main>
</Layout>

<style>
  .download-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    box-sizing: border-box;
    width: 240px;
    max-width: 100%;
    padding: 15px 12px;
    border-radius: 16px;
    background: #2057d4;
    color: white;
    font-size: 14px;
    white-space: nowrap;
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    transition: background-color 160ms ease;
  }

  .download-button:hover,
  .download-button:focus-visible {
    background: #1949b8;
  }

  .download-button svg {
    width: 22px;
    height: 22px;
    flex: none;
  }

  @media (max-width: 480px) {
    .download-button {
      gap: 8px;
      padding: 14px 12px;
    }

    .download-button svg {
      width: 22px;
      height: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .download-button {
      transition: none;
    }
  }
</style>
